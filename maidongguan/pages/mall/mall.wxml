<view class="root {{ elder ? 'elder' : '' }}">
  <view class="topbar">
    <view class="h1">麦冬农资</view>
    <view class="badge-geo">🛡 合规优选</view>
  </view>

  <view class="searchbar">
    <text class="sicon">🔍</text>
    <input class="sinput" placeholder="搜索肥料 / 农药 / 用途，如：控旺、根腐" value="{{ keyword }}" bindinput="onSearch" confirm-type="search" />
    <text wx:if="{{ keyword }}" class="sclear" bindtap="clearSearch">✕</text>
  </view>

  <view class="shelf-tabs">
    <view wx:for="{{ tabs }}" wx:key="*this"
          class="stab {{ active === index ? 'active' : '' }}"
          data-st="{{ index }}" bindtap="filterShelf">
      {{ index === 0 ? '全部' : item }}
    </view>
  </view>

  <view wx:if="{{ noResult }}" class="empty" style="padding:80rpx 60rpx">
    <image class="empty-img" src="/assets/img/empty.png" mode="aspectFit" />
    <view class="et">没有找到相关农资</view>
    <view class="em">换个关键词，或切换上方阶段货架看看</view>
  </view>

  <view wx:for="{{ products }}" wx:key="id" class="prod" data-id="{{ item.id }}" bindtap="openProduct">
    <view class="thumb">{{ item.emoji }}</view>
    <view class="info">
      <view class="pname">{{ item.name }}</view>
      <view class="row" style="gap:10rpx;margin-top:8rpx">
        <view class="pill {{ item.tagClass }}">{{ item.tag }}</view>
        <view class="xs muted">{{ item.use }}</view>
      </view>
      <view wx:if="{{ item.status !== '在售' }}" class="pill red" style="margin-top:10rpx">{{ item.status }}</view>
      <view class="row between mts">
        <view class="price">¥{{ item.price }}<small>/{{ item.spec }}</small></view>
        <view class="btn ghost sm" style="min-height:80rpx;font-size:26rpx">查看</view>
      </view>
    </view>
  </view>

  <view class="card tight" style="margin-top:12rpx">
    <view class="bold ink" style="font-size:30rpx">🛡 合规护栏</view>
    <view class="muted xs mts" style="line-height:1.5">已按禁用/限用农药清单校验（{{ bannedCount }} 项）· 多效唑残留红线 ≤{{ complianceMeta.muXiaoZuoLimit || '0.1' }}mg/kg · 采收前 {{ complianceMeta.safeIntervalDays || '30' }} 天自动停售化学药。平台仅提供商品信息，请遵标签与当地规定使用。</view>
    <view class="muted xs" style="margin-top:10rpx">合规数据版本：{{ complianceMeta.version }} · 来源：{{ complianceMeta.source }} · 更新于 {{ complianceMeta.updatedAt }}</view>
  </view>

  <!-- 商品详情抽屉 -->
  <view class="mask" wx:if="{{ sheetVisible }}" bindtap="closeSheet"></view>
  <view class="sheet" wx:if="{{ sheetVisible }}">
    <view class="closex" bindtap="closeSheet">×</view>
    <view class="h2">{{ cur.emoji }} {{ cur.name }}</view>
    <view class="row" style="gap:10rpx;margin-top:16rpx">
      <view class="pill {{ cur.tagClass }}">{{ cur.tag }}</view>
      <view class="xs muted">适配阶段：{{ tabs[cur.stage] }}</view>
    </view>
    <view class="price mtx">¥{{ cur.price }} <small style="color:var(--sub);font-weight:400">/ {{ cur.spec }}</small></view>
    <view class="card tight mtx" style="box-shadow:none;border:1rpx solid #e9ede9">
      <view class="bold ink sm">推荐用途</view>
      <view class="muted sm mts" style="line-height:1.55">{{ cur.use }}。本商品已通过合规校验，可安全用于川麦冬种植周期。</view>
    </view>
    <view class="risk">请严格按农药标签与当地规定使用，注意安全间隔期；平台仅提供商品信息。</view>
    <view wx:if="{{ cur.status !== '在售' }}" class="pill red" style="margin-top:16rpx">{{ cur.status }}：{{ cur.reason }}</view>
    <view class="row" style="gap:20rpx;margin-top:24rpx">
      <button class="btn ghost block" bindtap="addCart">加入购物车</button>
      <button class="btn block" disabled="{{ cur.status !== '在售' }}" bindtap="buyNow">立即购买</button>
    </view>
  </view>

  <view style="height:30rpx"></view>
</view>
