.root { padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.ticket { border-top:1rpx solid var(--line); padding:22rpx 0 6rpx; margin-top:20rpx; }
.ticket:first-of-type { border-top:none; margin-top:18rpx; }
.t-status { font-size:24rpx; padding:6rpx 16rpx; border-radius:20rpx; font-weight:700; }
.t-status.amber { background:#fdeede; color:#b9740a; }
.t-status.green { background:var(--green-l); color:var(--green-d); }
.t-land { color:var(--sub); }
.t-sym { font-size:28rpx; color:var(--ink); line-height:1.5; }
.t-rx { background:var(--bg); border-radius:20rpx; padding:18rpx 20rpx; margin-top:14rpx; }
.t-buy { font-size:25rpx; color:var(--green-d); background:var(--green-l); padding:10rpx 18rpx; border-radius:24rpx; font-weight:600; display:inline-block; }
.t-buy:active { opacity:.7; }
.root.elder .t-sym { font-size:32rpx; }
