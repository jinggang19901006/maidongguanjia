<view class="root {{ elder ? 'elder' : '' }}">
  <view class="topbar">
    <view class="h1">专家诊断</view>
    <view class="badge-geo">1分钟初诊·5分钟复核</view>
  </view>

  <view class="card">
    <view class="bold ink" style="font-size:32rpx">一键问诊</view>
    <view class="muted sm mts" style="line-height:1.5">AI 初诊 + 属地专家人工复核，输出带合规用法的电子处方。</view>

    <view class="field mtx" style="height:92rpx;display:flex;align-items:center">地块：{{ landName }}{{ curStage ? '（' + curStage + '）' : '' }}</view>

    <view class="row" style="gap:14rpx;margin-top:20rpx">
      <textarea class="field" style="flex:1;margin-top:0;height:180rpx" value="{{ symptom }}" bindinput="onSymptom" placeholder="请描述症状，例如：叶片发黄、根部褐色腐烂…（也可点右侧麦克风说话）"></textarea>
      <button class="mic" bindtap="onMic">🎤</button>
    </view>

    <view class="cam" style="height:200rpx;margin-top:20rpx;border-color:var(--green-d);font-size:28rpx" bindtap="addPhoto">＋ 添加照片（最多 6 张，已添加 {{ photos }} 张）</view>

    <button class="btn block mtx" disabled="{{ submitting }}" bindtap="submit">{{ submitting ? '派单中…' : '提交问诊' }}</button>
    <button class="call mtx" bindtap="call">📞 一键电话咨询农技员</button>
  </view>

  <view class="card" wx:if="{{ rx }}">
    <view class="row between">
      <view class="bold ink" style="font-size:33rpx">📋 电子处方</view>
      <view class="pill green">专家已复核</view>
    </view>
    <view class="muted xs mts">主治医师：{{ rx.doctor }} ｜ 复核用时 {{ rx.duration }}</view>
    <view class="sol mtx">
      <view class="h">🔬 诊断：{{ rx.diagnosis }}</view>
      <view wx:for="{{ rx.items }}" wx:key="n" class="item">
        <view><view class="name">{{ item.n }}</view><view class="spec">{{ item.s }}</view></view>
        <view class="buy" data-id="{{ item.buy }}" data-use="{{ item.n }}" bindtap="goBuy">去购买</view>
      </view>
    </view>
    <view class="risk">⚠️ 处方仅供参考，用药前请核对标签剂量、安全间隔期与当地规定；加强水分管理避免积水，采收前 30 天停用化学农药。</view>
  </view>

  <view class="card" wx:if="{{ tickets.length }}">
    <view class="row between">
      <view class="bold ink" style="font-size:33rpx">📑 我的问诊记录</view>
      <view class="xs muted">共 {{ tickets.length }} 条</view>
    </view>
    <view wx:for="{{ tickets }}" wx:key="id" class="ticket">
      <view class="row between">
        <view class="t-status {{ item.status === '待复核' ? 'amber' : 'green' }}">{{ item.status }}</view>
        <view class="xs muted">{{ item.createdAt }}</view>
      </view>
      <view class="t-land xs muted mts">地块：{{ item.land }}</view>
      <view class="t-sym mts">{{ item.symptom }}</view>
      <view wx:if="{{ item.rx }}" class="t-rx">
        <view class="xs muted">诊断：{{ item.rx.diagnosis }}</view>
        <view class="row" style="margin-top:10rpx;flex-wrap:wrap;gap:10rpx">
          <view wx:for="{{ item.rx.items }}" wx:for-item="rx" wx:key="n" class="t-buy" data-id="{{ rx.buy }}" data-use="{{ rx.n }}" bindtap="goBuy">购 {{ rx.n }}</view>
        </view>
      </view>
    </view>
  </view>
  <view class="card" wx:else>
    <view class="xs muted">暂无问诊记录，提交后这里会显示历史处方</view>
  </view>

  <view style="height:30rpx"></view>
</view>
