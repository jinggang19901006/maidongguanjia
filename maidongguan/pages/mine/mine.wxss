.root { padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }

/* 品牌头部 */
.profile { background: linear-gradient(135deg, #1a9d4e, #0f7a3a); padding: 48rpx 32rpx 64rpx; }
.p-top { display: flex; align-items: center; gap: 22rpx; }
.p-avatar { width: 104rpx; height: 104rpx; border-radius: 50%; background: rgba(255,255,255,.22); display: flex; align-items: center; justify-content: center; font-size: 54rpx; }
.p-user { flex: 1; }
.p-name { font-size: 38rpx; font-weight: 700; color: #fff; }
.p-sub { font-size: 24rpx; color: rgba(255,255,255,.85); margin-top: 8rpx; }
.p-setting { font-size: 40rpx; color: #fff; padding: 10rpx 14rpx; }

.p-stats { display: flex; margin-top: 44rpx; background: rgba(255,255,255,.16); border-radius: 24rpx; padding: 26rpx 0; }
.ps { flex: 1; text-align: center; position: relative; }
.ps::after { content: ""; position: absolute; right: 0; top: 14rpx; bottom: 14rpx; width: 1rpx; background: rgba(255,255,255,.25); }
.ps:last-child::after { display: none; }
.ps-n { font-size: 42rpx; font-weight: 700; color: #fff; }
.ps-l { font-size: 22rpx; color: rgba(255,255,255,.85); margin-top: 6rpx; }
.ps:active { opacity: .8; }

/* 服务宫格 */
.grid2 { display: flex; flex-wrap: wrap; gap: 18rpx; padding: 24rpx 28rpx; }
.gi { width: calc(33.33% - 12rpx); background: #fff; border-radius: 24rpx; padding: 28rpx 0; display: flex; flex-direction: column; align-items: center; gap: 14rpx; box-shadow: 0 4rpx 18rpx rgba(31,42,36,.05); }
.gi-ico { width: 84rpx; height: 84rpx; border-radius: 24rpx; display: flex; align-items: center; justify-content: center; font-size: 44rpx; }
.gi-t { font-size: 26rpx; color: var(--ink); font-weight: 600; }
.gi:active { transform: scale(.97); }

.root.elder .p-name { font-size: 42rpx; }
.root.elder .gi-t { font-size: 30rpx; }
.root.elder .ps-n { font-size: 46rpx; }
